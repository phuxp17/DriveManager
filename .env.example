POSTGRES_DB=storage_hub
POSTGRES_USER=storage_hub
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Optional: use an existing PostgreSQL instance for the isolated backend test schema.
USE_EXTERNAL_TEST_DATABASE=false
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/storage_hub
TEST_DATABASE_USERNAME=storage_hub
TEST_DATABASE_PASSWORD=

# Required only for Google Drive connect/upload/import.
# This must exactly match an authorized redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/app/connections/callback
